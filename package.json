{
  "name": "dsh-global-prompt",
  "version": "0.2.0",
  "description": "Community global prompt plugin for DeepSeek Harness 0.2.1-alpha.2: live profile settings and literal cross-session instructions.",
  "type": "module",
  "license": "MIT",
  "author": "Humengjiu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Humengjiu/dsh-global-prompt.git"
  },
  "homepage": "https://github.com/Humengjiu/dsh-global-prompt#readme",
  "bugs": {
    "url": "https://github.com/Humengjiu/dsh-global-prompt/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "global-prompt",
    "community-plugin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "README.md",
    "README.en.md",
    "LICENSE",
    "licenses",
    "docs/validation.md",
    "NOTICE",
    "cordis.patch.yml",
    "scripts/migrate-settings.mjs",
    "docs/upgrade-v0.2.md"
  ],
  "scripts": {
    "setup": "pnpm install --frozen-lockfile",
    "test": "vitest run",
    "smoke": "node scripts/built-smoke.mjs",
    "check": "pnpm test && pnpm run build && pnpm run smoke",
    "build": "node scripts/build.mjs",
    "migrate": "node scripts/migrate-settings.mjs",
    "pack": "pnpm pack --pack-destination dist"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-primitives"
      ],
      "platform": "web"
    },
    "bundle": {
      "patch": "cordis.patch.yml"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "react": "18.3.1",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1"
  },
  "communityCompatibility": {
    "harnessRepository": "https://github.com/deepseek-ai/deepseek-harness",
    "packageVersion": "0.2.1-alpha.2",
    "harnessRelease": "dsh-v0.2.1-alpha.2",
    "harnessCommit": "d743267388641bc76f17c45ce8b4c231aed1d32c",
    "verification": "Windows Web, released npm artifacts, official profile/settings path"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-client-ui-settings": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-renderer": {
      "optional": true
    }
  },
  "packageManager": "pnpm@11.28.5",
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5-alpha.1",
    "yaml": "2.8.1"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-api-remotes": "0.2.1-alpha.2",
    "@deepseek-ai/dsh": "0.2.1-alpha.2",
    "@deepseek-ai/cordis": "4.0.5-alpha.1",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.1-alpha.2",
    "vitest": "4.1.11",
    "@deepseek-ai/dsh-client-store": "0.2.1-alpha.2",
    "@types/node": "22.20.1",
    "react-dom": "18.3.1",
    "@deepseek-ai/cordis-plugin-loader": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-alpha.2",
    "@testing-library/dom": "10.4.1",
    "lightningcss": "1.33.0",
    "@deepseek-ai/dsh-settings": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-locale": "0.2.1-alpha.2",
    "typescript": "6.0.3",
    "tsdown": "0.22.2",
    "@deepseek-ai/cordis-plugin-include": "1.0.10-alpha.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.1-alpha.2",
    "@types/react": "18.3.1",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-alpha.2",
    "@types/react-dom": "18.3.0",
    "jsdom": "29.1.1",
    "@testing-library/react": "16.3.3",
    "react": "18.3.1",
    "@deepseek-ai/dsh-config-editor": "0.2.1-alpha.2",
    "@deepseek-ai/dsh-util-code-language": "0.2.1-alpha.2",
    "clsx": "^2.0.0",
    "diff": "^9.0.0",
    "anser": "^2.3.5",
    "katex": "^0.18.7",
    "micromark-core-commonmark": "^2.0.3",
    "micromark-util-character": "^2.1.1",
    "micromark-util-classify-character": "^2.0.1",
    "micromark-util-symbol": "^2.0.1",
    "micromark-util-types": "^2.0.2",
    "shiki": "^4.4.3",
    "@deepseek-ai/dsh-util-workspace-path": "0.2.1-alpha.2",
    "@shikijs/langs": "^4.4.3",
    "@types/mdast": "^4.0.4",
    "micromark-factory-space": "^2.0.1",
    "micromark-extension-math": "^3.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "micromark-util-sanitize-uri": "^2.0.1",
    "simple-icons": "16.31.0",
    "zustand": "~4.5.7",
    "immer": "^10.1.1"
  }
}
